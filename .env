# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  AMD Whisper WS Server — Production Configuration                       ║
# ║  Server: 142.93.152.160  |  Path: /root/amd-server/.env                ║
# ║                                                                         ║
# ║  RENAME THIS FILE TO .env AFTER UPLOADING:                              ║
# ║    mv env.txt .env                                                      ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# ─── Whisper Model ────────────────────────────────────────────────────────
WHISPER_MODEL_DIR=small.en
DEVICE=cuda
COMPUTE_TYPE=float16
# For CPU-only servers, uncomment below:
# DEVICE=cpu
# COMPUTE_TYPE=int8

# ─── ML Classifier ───────────────────────────────────────────────────────
CLASSIFIER_PATH=../models/text_cls_amd_v2.joblib

# ─── Server ──────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8989
WORKERS=1
MAX_CALL_SEC=2.5
DEBUG=false

# ─── Silero VAD ──────────────────────────────────────────────────────────
SILERO_VAD_THRESHOLD=0.3
SILERO_MIN_SPEECH_MS=100
SILERO_VAD_DIR=

# ─── Audio Processing ────────────────────────────────────────────────────
SILENCE_RMS_THRESHOLD=0.003
TARGET_RMS=0.08
MAX_GAIN=2.5
SOXR_QUALITY=HQ

# ─── Whisper Prompt ──────────────────────────────────────────────────────
INITIAL_PROMPT=voicemail, message, beep, tone, press, mailbox, answering machine, automated attendant

# ─── Hallucination Prevention ────────────────────────────────────────────
MIN_SPEECH_RATIO=0.15
MIN_CONFIDENCE_GREETING=0.50
MIN_SPEECH_MS_HUMAN=700
MIN_P2A_RATIO=3.5
NOISE_P2A_THRESHOLD=3.2
SHORT_SPEECH_THRESHOLD=500
LOW_CONF_THRESHOLD=0.52


# ─── Audio Storage (SFTP to Hetzner Storage Box) ─────────────────────────
AUDIO_SAVE_ENABLED=true
AUDIO_FORMAT=mp3
AUDIO_SAVE_FILTER=all
# Options: all | machine | human

STORAGE_SERVER=u563163.your-storagebox.de
STORAGE_PORT=23
STORAGE_USER=u563163
STORAGE_PASSWORD=AMD$server!1122@ARC
STORAGE_PATH=/home/audio_storage

MP3_BITRATE=64k
AUDIO_QUEUE_SIZE=1000
AUDIO_MAX_RETRIES=3
AUDIO_RETRY_DELAY=2.0
AUDIO_CONN_TIMEOUT=15
AUDIO_KEEPALIVE=30
AUDIO_DEBUG=false

# ─── Audio URL (for Elasticsearch/Kibana playback links) ─────────────────
AUDIO_URL_USER=u563163
AUDIO_URL_PASSWORD=AMD$server!1122@ARC
AUDIO_URL_HOST=u563163.your-storagebox.de
AUDIO_URL_BASE_DIR=audio_storage

# ─── Python / Torch Noise Suppression ───────────────────────────────────
KMP_WARNINGS=0
TF_CPP_MIN_LOG_LEVEL=3
PYTHONWARNINGS=ignore
TORCH_SHOW_CPP_STACKTRACES=0